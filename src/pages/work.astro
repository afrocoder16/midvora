---
import BaseLayout from '../layouts/BaseLayout.astro';
import StudioMeta from '../components/StudioMeta.astro';
import StudioCTA from '../components/StudioCTA.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { liveProjects, previewProjects } from '../data/projects';
const images = import.meta.glob<{ default: ImageMetadata }>('/public/work/*.webp', { eager: true });
const asset = (path: string) => images['/public' + path].default;
const liveTones = ['sage', 'pink', 'peach', 'blue', 'pink'];
const previewTones = ['peach', 'sage', 'blue', 'pink', 'sage'];
const allProjects = [
  ...liveProjects.map((project, i) => ({ ...project, status: 'live', tone: liveTones[i % liveTones.length] })),
  ...previewProjects.map((project, i) => ({ ...project, status: 'preview', tone: previewTones[i % previewTones.length] })),
];
---
<BaseLayout title="Our Work — Different Businesses. Distinctly Their Own. | Midvora" description="Explore Midvora’s live client websites and working previews. Distinctive design for food, retail, pet care, and local services across the Midwest.">
  <section id="hero" class="studio-hero gallery-hero"><div class="home-shell"><StudioMeta label="Our work / A collection of local originals" /><div class="gallery-intro"><h1>Good businesses.<br /><em>Great company.</em></h1><div><p>Different stories. Different personalities.{' '}<br />A little Midvora in the making.</p><a class="home-text-link" href="#live-work">Meet the collection <span aria-hidden="true">↓</span></a></div></div>
  <div class="gallery-wall" data-motion-zone><div class="gallery-wall-grid" aria-hidden="true"></div><a href="#project-1" class="gallery-print print-left"><span>01 / CARE, WITH CHARACTER</span><Image src={asset(liveProjects[0].images[0])} format="webp" widths={[480, 800]} sizes="(max-width: 700px) 55vw, 34vw" width={800} alt="Animal Health Center website" loading="eager" /><span>Animal Health Center ↗︎</span></a><a href="#project-2" class="gallery-print print-center"><span>02 / A LITTLE EXTRA FLAVOR</span><Image src={asset(liveProjects[1].images[0])} format="webp" widths={[480, 800, 1200]} sizes="(max-width: 700px) 75vw, 50vw" width={1200} alt="La Michoacana Elite website" loading="eager" fetchpriority="high" /><span>La Michoacana Elite ↗︎</span></a><a href="#project-3" class="gallery-print print-right"><span>03 / A LOCAL FAVORITE</span><Image src={asset(liveProjects[2].images[0])} format="webp" widths={[480, 800]} sizes="(max-width: 700px) 55vw, 34vw" width={800} alt="La Tapatia Food Truck website" loading="eager" /><span>La Tapatia ↗︎</span></a><div class="gallery-stamp studio-float" aria-hidden="true">Made here.<br /><em>Made for you.</em><span>THE MIDVORA COLLECTION</span></div></div>
  <div class="studio-hero-bottom"><span>{liveProjects.length} live client websites</span><span>{previewProjects.length} working previews</span><span>Each with a story of its own.</span><a href="/contact">Yours could be next ↗︎</a></div></div></section>
  <section id="live-work" class="studio-section collection-section"><div class="home-shell"><div class="collection-toolbar"><div><p class="home-eyebrow">The collection</p><h2>Take a <em>closer look.</em></h2></div><div class="collection-filters" aria-label="Filter projects" role="group" hidden><button type="button" data-filter="all" aria-pressed="true">All work <span>{allProjects.length.toString().padStart(2, '0')}</span></button><button type="button" data-filter="live" aria-pressed="false">Live sites <span>{liveProjects.length.toString().padStart(2, '0')}</span></button><button type="button" data-filter="preview" aria-pressed="false">Previews <span>{previewProjects.length.toString().padStart(2, '0')}</span></button></div></div><p class="collection-note" id="collection-count" role="status">{allProjects.length} projects. Live client sites and working launch previews.</p><div class="collection-grid">{allProjects.map((project, i) => <article id={`project-${i + 1}`} class={`collection-card collection-${project.tone}`} data-project-status={project.status} data-home-reveal style={`--reveal-order:${i % 2}`}><div class="collection-media"><div class="collection-media-top"><span>{(i + 1).toString().padStart(2, '0')} / {project.category}</span><span class={`project-status status-${project.status}`}><i></i>{project.status === 'live' ? 'Live site' : 'Preview'}</span></div><a href={project.url} target="_blank" rel="noopener noreferrer" class="collection-window" aria-label={`Open ${project.title} ${project.status === 'live' ? 'website' : 'preview'} in a new tab`}><span class="collection-window-bar" aria-hidden="true"><i></i><i></i><i></i><span>{project.displayUrl}</span></span><Image src={asset(project.images[0])} format="webp" widths={[480, 800, 1200]} sizes="(max-width: 700px) 90vw, 45vw" width={1200} alt={`${project.title} homepage`} loading="lazy" decoding="async" data-project-main /></a><div class="project-pages" role="group" aria-label={`Preview screenshots of ${project.title}`} hidden><span>Explore the details</span>{project.images.map((image, index) => <button type="button" data-project-image={image} data-project-alt={`${project.title}, screenshot ${index + 1}`} aria-label={`View screenshot ${index + 1} of ${project.title}`} aria-pressed={index === 0 ? 'true' : 'false'}>0{index + 1}</button>)}</div></div><div class="collection-copy"><span>{project.location}</span><h3><a href={project.url} target="_blank" rel="noopener noreferrer">{project.title}<span aria-hidden="true">↗︎</span></a></h3><p>{project.description}</p></div></article>)}</div></div></section>
  <StudioCTA eyebrow="There is room for your story here" title="Let’s put you" accent="in good company." />
</BaseLayout>
<script>
  const filters = document.querySelector<HTMLElement>('.collection-filters');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-project-status]')];
  if (filters) {
    filters.hidden = false;
    filters.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button => button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      cards.forEach(card => { card.hidden = filter !== 'all' && card.dataset.projectStatus !== filter; });
      filters.querySelectorAll('button').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      const count = cards.filter(card => !card.hidden).length;
      const status = document.querySelector('#collection-count');
      if (status) status.textContent = count + (filter === 'live' ? ' live client websites.' : filter === 'preview' ? ' working launch previews.' : ' projects. Live client sites and working launch previews.');
    }));
  }
  cards.forEach(card => {
    const controls = card.querySelector<HTMLElement>('.project-pages');
    if (controls) controls.hidden = false;
    card.querySelectorAll<HTMLButtonElement>('[data-project-image]').forEach(button => button.addEventListener('click', () => {
      const image = card.querySelector<HTMLImageElement>('[data-project-main]');
      if (!image || !button.dataset.projectImage) return;
      image.removeAttribute('srcset');
      image.src = button.dataset.projectImage;
      image.alt = button.dataset.projectAlt || '';
      card.querySelectorAll('[data-project-image]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    }));
  });
</script>
