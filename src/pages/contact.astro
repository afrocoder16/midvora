---
import BaseLayout from '../layouts/BaseLayout.astro';
import StudioMeta from '../components/StudioMeta.astro';
import StudioArt from '../components/StudioArt.astro';
const questions = [
  { q: 'Is the sample really free?', a: 'Yes. Your first working homepage sample is free to explore, with no payment details or commitment. You decide whether to move forward after seeing the direction.' },
  { q: 'What should I send you?', a: 'Your business name, location, and a way to reach you are a great start. A link to your current website and a little about what you have in mind will help us make it feel like you.' },
  { q: 'What happens after I press send?', a: 'We review your information, reach out if we need anything else, and build your free working homepage sample. Expect to hear from us within 24 hours.' },
  { q: 'Do I need to be in the Midwest?', a: 'We’re based in Marshall, Minnesota, and serve Minnesota, South Dakota, and North Dakota. We also welcome remote projects from businesses anywhere.' },
];
---
<BaseLayout title="Let’s Talk — Your Next Chapter Starts Here | Midvora" description="Tell Midvora about your business and get a free working homepage sample in 24 hours. Call (507) 530-4837 or email info@midvora.com.">
  <section id="hero" class="studio-hero contact-hero"><div class="home-shell"><StudioMeta label="Let’s talk / One hello changes everything" /><div class="contact-hero-grid"><div class="contact-intro"><h1>Big things.<br /><em>Small hello.</em></h1><p>A new website, a fresh direction, or an idea you can’t stop thinking about. We’d love to hear it.</p><div class="contact-direct"><a href="mailto:info@midvora.com">info@midvora.com <span aria-hidden="true">↗</span></a><a href="tel:+15075304837">(507) 530-4837 <span aria-hidden="true">↗</span></a></div><StudioArt kind="hello" /><p class="contact-art-note">A little local love, sent your way.</p></div>
    <div class="contact-form-wrap"><form id="sample-form" class="studio-contact-form"><div class="contact-form-title"><span class="home-eyebrow">Your first look is on us</span><span class="contact-free-badge">FREE / 24H</span></div><h2>Tell us a little<br /><em>about you.</em></h2><p>A few details. A whole new beginning.</p><div class="contact-request-summary" id="request-summary" hidden><span>Your starting point</span><strong id="request-summary-text"></strong><a href="/services#build-your-own">Change your selection ↗</a></div><input type="hidden" name="projectSelection" id="project-selection" />
      <div class="contact-field-row"><label>Your name <span aria-hidden="true">*</span><input name="yourName" autocomplete="name" placeholder="The person behind the business" maxlength="160" required /></label><label>Business name <span aria-hidden="true">*</span><input name="businessName" autocomplete="organization" placeholder="The name above your door" maxlength="160" required /></label></div>
      <div class="contact-field-row"><label>Email <span aria-hidden="true">*</span><input name="email" type="email" autocomplete="email" placeholder="Where we can send your sample" maxlength="200" required /></label><label>Phone <small>(optional)</small><input name="phone" type="tel" autocomplete="tel" placeholder="If you’d like a call or text" maxlength="40" /></label></div>
      <div class="contact-field-row"><label>What do you do?<select name="businessType"><option value="">Choose your business type</option>{['Restaurant or café', 'Retail or boutique', 'Salon or wellness', 'Contractor or home services', 'Auto services', 'Pet care', 'Professional services', 'Something else'].map(type => <option>{type}</option>)}</select></label><label>City & state<input name="cityState" autocomplete="address-level2" placeholder="Marshall, MN" maxlength="160" /></label></div>
      <label>Current website <small>(optional)</small><input name="currentWebsite" type="url" autocomplete="url" placeholder="https://your-business.com" maxlength="500" /></label><label>What do you have in mind? <small>(optional)</small><textarea name="message" rows="3" placeholder="A fresh look, a new menu, a big idea. We’re listening." maxlength="5000"></textarea></label><div class="home-honeypot" aria-hidden="true"><label>Leave this empty<input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label></div>
      <button class="home-button home-button-blue" type="submit"><span data-submit-label>Let’s make my free sample</span><span aria-hidden="true">↗</span></button><p class="contact-submit-note">$0 until you approve. No payment details needed.</p><p class="contact-form-status" id="form-status" role="status" aria-live="polite" hidden></p>
    </form><div class="contact-success" id="contact-success" hidden><span class="success-sun" aria-hidden="true">✳</span><p class="home-eyebrow">A good beginning</p><h2>Your next chapter<br /><em>is on its way.</em></h2><p>We’ve received your details. Look out for a message from us about your free sample within 24 hours.</p><a href="/work" class="home-button home-button-blue">Meet some of our work <span aria-hidden="true">↗</span></a><button id="send-another" type="button">Send another request</button></div></div>
  </div></div></section>
  <section class="studio-section contact-details-section"><div class="home-shell contact-details-grid"><div><p class="home-eyebrow">Our corner of the world</p><h2>Close to home.<br /><em>Easy to reach.</em></h2></div><div><span class="detail-number">01 / COME SAY HELLO</span><h3>Marshall, Minnesota</h3><p>107 E Main<br />Marshall, MN 56258</p><a href="https://www.google.com/maps/search/?api=1&query=107+E+Main+Marshall+MN+56258" target="_blank" rel="noopener noreferrer">Find us on the map ↗</a></div><div><span class="detail-number">02 / WHEN WE’RE AROUND</span><h3>A good time to talk.</h3><p>Monday–Friday: 8am–6pm CT<br />Saturday: by appointment<br />Sunday: closed</p><span class="contact-response">We usually respond within 2 hours during business hours.</span></div></div></section>
  <section class="studio-section studio-faq"><div class="home-shell faq-grid"><div><p class="home-eyebrow">Before you say hello</p><h2>A few<br /><em>quick answers.</em></h2></div><div>{questions.map(item => <details class="studio-details"><summary>{item.q}<span aria-hidden="true">+</span></summary><p>{item.a}</p></details>)}</div></div></section>
</BaseLayout>
<script>
  import '../scripts/contact';
</script>
