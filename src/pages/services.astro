---
import BaseLayout from '../layouts/BaseLayout.astro';
import StudioMeta from '../components/StudioMeta.astro';
import StudioArt from '../components/StudioArt.astro';
import StudioCTA from '../components/StudioCTA.astro';
import { Picture } from 'astro:assets';
import prairieLight from '../assets/midvora-prairie-light.png';
import { packages, carePlans, money } from '../data/services';
import { servicesSchema, faqSchema } from '../data/seo';
const questions = [
  { q: 'What is included in a website package?', a: 'Your custom website, hosting, security, and weekly maintenance. Every package starts with a free sample. You’ll know the full scope and price before you approve.' },
  { q: 'What happens after the first year?', a: 'Your first-year price covers designing, building, and launching your website. After that, you choose a care plan: Care at $300 a year, or Care Plus at $500 a year. Either way, your website stays online, secure, and looked after.' },
  { q: 'Can you help if I’m just starting out?', a: 'Yes, and it’s one of our favorite things to do. We build small one or two page websites from $300, and we offer free first websites for new businesses and for churches. Tell us where you are and we’ll find a way that works.' },
  { q: 'How soon can my website go live?', a: 'Starter websites typically launch in 5–7 days after approval with your content ready. Allow about 10 days for Growth and 14 days for Premium. We’ll confirm the timeline for your project.' },
  { q: 'What if the first design isn’t quite me?', a: 'Tell us what you think. The free working sample gives you something real to react to, and revisions are included when you move forward. You owe nothing before you approve.' },
  { q: 'Do I own my website?', a: 'Yes. Your domain, website code, and content belong to you. We set things up in your name and can hand over access whenever you need it.' },
  { q: 'Can you help with my existing website?', a: 'Absolutely. Send us the link and tell us what you’d like to change. We can talk through a refresh, a complete redesign, or something more specific.' },
];
---
<BaseLayout title="Website Design Pricing from $300 | Midvora, Marshall MN" description="Custom website packages from $300 with hosting, security, and weekly care included. Free first websites for new businesses and churches. Based in Marshall, MN." breadcrumb={[['Services & Pricing', '/services/']]} schema={[servicesSchema(), faqSchema('/services/', questions)]}>
  <section id="hero" class="studio-hero service-hero"><div class="home-shell"><StudioMeta label="What we do / Design, build, and a little extra care" /><div class="studio-hero-grid"><div class="studio-hero-copy"><h1>A little more<br /><em>possibility.</em><br />A lot more you.</h1><p>A website with a point of view. The tools to make it useful. And someone who cares about it after launch.</p><div class="studio-actions"><a href="#svc-packages" class="home-button home-button-blue">Find your starting point <span aria-hidden="true">↓</span></a><a href="#helping" class="hero-free-pill"><b>FREE</b><span>for new businesses &amp; churches</span><span aria-hidden="true">↓</span></a></div><span class="studio-hero-note">Websites from $300. Your first look is on us.</span></div><StudioArt kind="build" /></div><div class="studio-hero-bottom"><span>01 / Thoughtful design</span><span>02 / Useful technology</span><span>03 / Ongoing care</span><a href="/work/">See it in the real world ↗︎</a></div></div></section>
  <section id="svc-packages" class="studio-section package-section"><div class="home-shell"><div class="studio-section-head" data-home-reveal><div><p class="home-eyebrow">Clear prices. Good beginnings.</p><h2>Small investment.<br /><em>Big first impression.</em></h2></div><p>Hosting, security, and weekly maintenance are included in every website package. Start with a sample. Pay when you approve.</p></div><div class="studio-packages">{packages.map((pkg, i) => <article class={`studio-package package-${pkg.tone}`} data-home-reveal style={`--reveal-order:${i}`}><div class="package-top"><span>0{i + 1} / {pkg.caption}</span><span aria-hidden="true">{i === 0 ? '↗︎' : i === 1 ? '✳' : '✦'}</span></div><h3>{pkg.name}</h3><p class="package-price">{money(pkg.price)}<span>your first year</span></p><p class="package-description">{pkg.description}</p><a href={`/contact/?package=${pkg.id}#sample-form`} class="home-button">Start with {pkg.name} <span aria-hidden="true">↗︎</span></a><ul>{pkg.features.map(feature => <li><span aria-hidden="true">✓</span>{feature}</li>)}</ul><p class="package-timeline">Launch in {pkg.timeline}<span>after approval & content</span></p></article>)}</div>
  <div class="care-band" data-home-reveal><div class="care-intro"><span class="included-symbol" aria-hidden="true">✳</span><div><p class="home-eyebrow">After your first year</p><h3>Built with care. <em>Kept that way.</em></h3><p>Your first-year price covers designing, building, and launching your website. After that, one simple care plan keeps it online, secure, and looked after.</p></div></div><div class="care-plans">{carePlans.map(plan => <article class="care-plan"><span class="care-usually">{plan.usually}</span><h4>{plan.name}</h4><p class="care-price">{money(plan.price)}<span>a year</span></p>{plan.monthly && <p class="care-monthly">About {money(plan.monthly)} a month</p>}<p class="care-copy">{plan.description}</p></article>)}</div></div></div></section>
  <section id="helping" class="helping-section"><div class="home-shell">
    <div class="helping-head"><div class="helping-copy" data-home-reveal><p class="home-eyebrow">What we love doing most</p><h2>Just getting started?<br /><em>We’ve got you.</em></h2><p>A website shouldn’t be the thing that holds a new business back. Tell us where you are, and we’ll find a way to help.</p></div><div class="helping-art" aria-hidden="true"><Picture src={prairieLight} formats={['avif']} fallbackFormat="webp" widths={[480, 800, 1254]} sizes="(max-width: 700px) 80vw, 38vw" width={1254} height={1254} alt="" loading="lazy" decoding="async" /></div></div>
    <div class="helping-grid"><article class="helping-card" data-home-reveal style="--reveal-order:0"><span class="helping-tag">01 / Small business</span><p class="helping-big"><small>from</small>$300</p><h3>A small website.</h3><p>One or two pages with everything a neighbor needs: who you are, what you do, and how to reach you.</p><a class="helping-cta" href="/contact/?package=small#sample-form">Start small <span aria-hidden="true">↗︎</span></a></article><article class="helping-card helping-card-free" data-home-reveal style="--reveal-order:1"><span class="helping-tag">02 / Just opened</span><p class="helping-big">FREE</p><h3>Your first website.</h3><p>Detailers, power washers, brand-new shops: if you’ve just started out, we’ll build your first website free. We’ll sort out hosting and care together.</p><a class="helping-cta" href="/contact/?package=new-business#sample-form">Tell us your story <span aria-hidden="true">↗︎</span></a></article><article class="helping-card helping-card-free" data-home-reveal style="--reveal-order:2"><span class="helping-tag">03 / Churches</span><p class="helping-big">FREE</p><h3>Your first year.</h3><p>We’ll build your church’s website free for its first year. Hosting and care begin after that.</p><a class="helping-cta" href="/contact/?package=church#sample-form">Say hello <span aria-hidden="true">↗︎</span></a></article></div>
    <p class="helping-note" data-home-reveal>Not sure what you can swing? Tell us. We’d rather build it right than turn you away. <a class="home-button home-button-blue" href="/contact/#sample-form">Let’s talk <span aria-hidden="true">↗︎</span></a></p></div></section>
  <section class="studio-section service-menu"><div class="home-shell"><div class="studio-section-head" data-home-reveal><div><p class="home-eyebrow">Beyond the homepage</p><h2>The right pieces.<br /><em>A better whole.</em></h2></div><p>One studio for the details that connect your business to the people looking for it.</p></div><div class="service-menu-grid"><article data-home-reveal><span class="service-drawing drawing-brand" aria-hidden="true">Aa<span>↗︎</span></span><div><span class="home-eyebrow">01 / Identity & content</span><h3>Look like yourself.</h3><p>Logos, photography, and a social presence with the same personality as the business behind it.</p><span class="service-prices">Just ask. We’ll keep it simple.</span></div></article><article data-home-reveal><span class="service-drawing drawing-find" aria-hidden="true"><i></i><b>m.</b></span><div><span class="home-eyebrow">02 / Discovery & connection</span><h3>Find your people.</h3><p>Google Business Profile, email, QR menus, and the small touches that make the next step easy.</p><span class="service-prices">Just ask. We’ll keep it simple.</span></div></article></div>
  <details class="studio-details service-more"><summary>Something more ambitious? <span aria-hidden="true">+</span></summary><div class="advanced-services">{[{ name: 'Custom web applications', price: '$2,000–$5,000', copy: 'Booking, dashboards, inventory, and workflows shaped around your business.' }, { name: 'E-commerce stores', price: '$1,500–$3,000', copy: 'A complete shopping experience with payments, shipping, and inventory.' }, { name: 'Cybersecurity audits', price: '$300–$2,500', copy: 'Understand your vulnerabilities and the steps to address them.' }, { name: 'Mobile apps', price: 'Custom quote', copy: 'Ordering, booking, loyalty, or a fresh idea for iOS and Android.' }, { name: 'Event websites', price: '$250', copy: 'One place for your event, its details, and your guests.' }, { name: 'Call tracking setup', price: '$99', copy: 'Understand the calls your website helps bring in.' }].map(service => <article><h3>{service.name}</h3><strong>{service.price}</strong><p>{service.copy}</p></article>)}</div></details></div></section>
  <section class="studio-section studio-faq"><div class="home-shell faq-grid"><div><p class="home-eyebrow">Good questions</p><h2>A little clarity<br /><em>goes a long way.</em></h2><a href="/contact/" class="home-text-link">Ask us anything ↗︎</a></div><div>{questions.map(item => <details class="studio-details"><summary>{item.q}<span aria-hidden="true">+</span></summary><p>{item.a}</p></details>)}</div></div></section>
  <StudioCTA />
</BaseLayout>
