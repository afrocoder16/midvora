---
import BaseLayout from '../layouts/BaseLayout.astro';
import StudioMeta from '../components/StudioMeta.astro';
import StudioArt from '../components/StudioArt.astro';
import StudioCTA from '../components/StudioCTA.astro';
import PackageBuilder from '../components/PackageBuilder.astro';
import { packages, bundles, money } from '../data/services';
const questions = [
  { q: 'What is included in a website package?', a: 'Your custom website, hosting, security, and weekly maintenance. Every package starts with a free sample. You’ll know the full scope and price before you approve.' },
  { q: 'How soon can my website go live?', a: 'Starter websites typically launch in 5–7 days after approval with your content ready. Allow about 10 days for Growth and 14 days for Premium. We’ll confirm the timeline for your project.' },
  { q: 'What if the first design isn’t quite me?', a: 'Tell us what you think. The free working sample gives you something real to react to, and revisions are included when you move forward. You owe nothing before you approve.' },
  { q: 'Do I own my website?', a: 'Yes. Your domain, website code, and content belong to you. We set things up in your name and can hand over access whenever you need it.' },
  { q: 'Can you help with my existing website?', a: 'Absolutely. Send us the link and tell us what you’d like to change. We can talk through a refresh, a complete redesign, or something more specific.' },
];
---
<BaseLayout title="Services & Pricing — A Little More Possibility | Midvora" description="Custom websites from $525, including hosting, security, and weekly maintenance. Explore Midvora’s packages, creative services, and build-your-own estimate.">
  <section id="hero" class="studio-hero service-hero"><div class="home-shell"><StudioMeta label="What we do / Design, build, and a little extra care" /><div class="studio-hero-grid"><div class="studio-hero-copy"><h1>A little more<br /><em>possibility.</em><br />A lot more you.</h1><p>A website with a point of view. The tools to make it useful. And someone who cares about it after launch.</p><div class="studio-actions"><a href="#svc-packages" class="home-button home-button-blue">Find your starting point <span aria-hidden="true">↓</span></a><a href="#build-your-own" class="home-text-link">Make it your own ↗︎</a></div><span class="studio-hero-note">Websites from $525. Your first look is on us.</span></div><StudioArt kind="build" /></div><div class="studio-hero-bottom"><span>01 / Thoughtful design</span><span>02 / Useful technology</span><span>03 / Ongoing care</span><a href="/work">See it in the real world ↗︎</a></div></div></section>
  <section id="svc-packages" class="studio-section package-section"><div class="home-shell"><div class="studio-section-head" data-home-reveal><div><p class="home-eyebrow">Clear prices. Good beginnings.</p><h2>Small investment.<br /><em>Big first impression.</em></h2></div><p>Hosting, security, and weekly maintenance are included in every website package. Start with a sample. Pay when you approve.</p></div><div class="studio-packages">{packages.map((pkg, i) => <article class={`studio-package package-${pkg.tone}`} data-home-reveal style={`--reveal-order:${i}`}><div class="package-top"><span>0{i + 1} / {pkg.caption}</span><span aria-hidden="true">{i === 0 ? '↗︎' : i === 1 ? '✳' : '✦'}</span></div><h3>{pkg.name}</h3><p class="package-price">{money(pkg.price)}<span>website package</span></p><p class="package-description">{pkg.description}</p><a href={`/contact?package=${pkg.id}#sample-form`} class="home-button">Start with {pkg.name} <span aria-hidden="true">↗︎</span></a><ul>{pkg.features.map(feature => <li><span aria-hidden="true">✓</span>{feature}</li>)}</ul><p class="package-timeline">Launch in {pkg.timeline}<span>after approval & content</span></p></article>)}</div><div class="package-included"><span class="included-symbol" aria-hidden="true">✳</span><div><strong>Built with care. Kept that way.</strong><p>Hosting, security, and weekly maintenance. The things your website needs, already taken care of.</p></div><a href="/contact">Let’s talk about your business ↗︎</a></div></div></section>
  <section class="studio-section service-menu"><div class="home-shell"><div class="studio-section-head" data-home-reveal><div><p class="home-eyebrow">Beyond the homepage</p><h2>The right pieces.<br /><em>A better whole.</em></h2></div><p>One studio for the details that connect your business to the people looking for it.</p></div><div class="service-menu-grid"><article data-home-reveal><span class="service-drawing drawing-brand" aria-hidden="true">Aa<span>↗︎</span></span><div><span class="home-eyebrow">01 / Identity & content</span><h3>Look like yourself.</h3><p>Logos, photography, and a social presence with the same personality as the business behind it.</p><span class="service-prices">Brand kits $50 · Photos $200 · Social kits $150</span></div></article><article data-home-reveal><span class="service-drawing drawing-find" aria-hidden="true"><i></i><b>m.</b></span><div><span class="home-eyebrow">02 / Discovery & connection</span><h3>Find your people.</h3><p>Google Business Profile, email, QR menus, and the small touches that make the next step easy.</p><span class="service-prices">Google setup $50 · Email $175 · QR menus $49</span></div></article></div>
  <details class="studio-details service-more"><summary>Something more ambitious? <span aria-hidden="true">+</span></summary><div class="advanced-services">{[{ name: 'Custom web applications', price: '$2,000–$5,000', copy: 'Booking, dashboards, inventory, and workflows shaped around your business.' }, { name: 'E-commerce stores', price: '$1,500–$3,000', copy: 'A complete shopping experience with payments, shipping, and inventory.' }, { name: 'Cybersecurity audits', price: '$300–$2,500', copy: 'Understand your vulnerabilities and the steps to address them.' }, { name: 'Mobile apps', price: 'Custom quote', copy: 'Ordering, booking, loyalty, or a fresh idea for iOS and Android.' }, { name: 'Event websites', price: '$250', copy: 'One place for your event, its details, and your guests.' }, { name: 'Call tracking setup', price: '$99', copy: 'Understand the calls your website helps bring in.' }].map(service => <article><h3>{service.name}</h3><strong>{service.price}</strong><p>{service.copy}</p></article>)}</div></details>
  <details class="studio-details"><summary>A few things work better together. Explore bundles. <span aria-hidden="true">+</span></summary><div class="bundle-grid">{bundles.map(bundle => <article><h3>{bundle.name}</h3><p>{bundle.detail}</p><strong>{money(bundle.price)} <small>Save {money(bundle.saving)}</small></strong><a href={`/contact?package=${bundle.id}#sample-form`}>Start with this bundle ↗︎</a></article>)}</div></details></div></section>
  <PackageBuilder />
  <section class="studio-section studio-faq"><div class="home-shell faq-grid"><div><p class="home-eyebrow">Good questions</p><h2>A little clarity<br /><em>goes a long way.</em></h2><a href="/contact" class="home-text-link">Ask us anything ↗︎</a></div><div>{questions.map(item => <details class="studio-details"><summary>{item.q}<span aria-hidden="true">+</span></summary><p>{item.a}</p></details>)}</div></div></section>
  <StudioCTA />
</BaseLayout>
