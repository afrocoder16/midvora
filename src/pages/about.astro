---
import BaseLayout from '../layouts/BaseLayout.astro';
import StudioMeta from '../components/StudioMeta.astro';
import StudioCTA from '../components/StudioCTA.astro';
import { Picture } from 'astro:assets';
import prairieLight from '../assets/midvora-prairie-light.png';
---
<BaseLayout title="The Studio — Midwest Roots. Brighter Ideas. | Midvora" description="Meet Midvora, an independent web studio in Marshall, Minnesota. Thoughtful websites, fair prices, and a little local pride. Midwest is where we start. Light is what we bring.">
  <section id="hero" class="studio-hero about-hero"><div class="home-shell"><StudioMeta label="The studio / Rooted here. Radiating outward." /><div class="studio-hero-grid"><div class="studio-hero-copy"><h1>Midwest roots.<br /><em>Brighter ideas.</em></h1><p>We believe the business down the street deserves a website with as much character as the people behind it.</p><p class="about-hero-small">We’re Midvora. An independent web studio in Marshall, Minnesota, making good businesses easier to find, love, and remember.</p><a href="#our-story" class="home-text-link">A little about us <span aria-hidden="true">↓</span></a></div><figure class="prairie-art" data-motion-zone><div class="studio-float"><Picture src={prairieLight} formats={['avif']} fallbackFormat="webp" widths={[480, 800, 1254]} sizes="(max-width: 700px) 110vw, 55vw" width={1254} height={1254} alt="An amber glass sun rises over sculptural cobalt prairie hills and flowing ivory paper contours." loading="eager" fetchpriority="high" /></div><figcaption><span>THE PRAIRIE, IN A NEW LIGHT.</span><span>44.45° N / 95.79° W</span></figcaption></figure></div></div></section>
  <section id="our-story" class="studio-section name-story"><div class="home-shell"><div class="name-equation" aria-label="Midwest plus light makes Midvora"><div><span>Mid</span><p>The place that shaped us.</p><strong>Midwest</strong></div><b aria-hidden="true">+</b><div><em>vora</em><p>The thing we want to bring.</p><strong>Light</strong></div></div><div class="name-story-bottom"><p>A light for the businesses<br /><em>that deserve to be seen.</em></p><div><p>A favorite restaurant. A trusted repair shop. A place that knows your name. These businesses make a community feel like home.</p><p>We help their websites feel that way, too. With thoughtful design, useful details, and a clear next step for the people who find them.</p></div></div></div></section>
  <section class="studio-section studio-beliefs"><div class="home-shell"><div class="studio-section-head" data-home-reveal><div><p class="home-eyebrow">The way we see it</p><h2>Good work.<br /><em>Good intentions.</em></h2></div><p>A few things we believe should come with every website. Ours certainly do.</p></div><div class="belief-list">{[{title: 'Character over sameness.',copy: 'Your story, your customers, your corner of the world. We design around those things, so your website feels unmistakably yours.',symbol:'Aa'}, {title:'Show first. Earn trust.',copy:'A free working sample gives you something real to explore. See the direction, try it on your phone, and decide when it feels right.',symbol:'↗︎'}, {title:'Care is part of the craft.',copy:'Hosting, security, and weekly maintenance come with your website package. Launch day is the beginning of looking after it.',symbol:'✳'}].map((belief,i) => <article data-home-reveal><span class="belief-index">0{i+1}</span><div><h3>{belief.title}</h3><p>{belief.copy}</p></div><span class={`belief-symbol symbol-${i}`} aria-hidden="true">{belief.symbol}</span></article>)}</div></div></section>
  <section class="studio-section neighborhood-section"><div class="home-shell neighborhood-grid"><div class="mainstreet-art" aria-hidden="true" data-motion-zone><div class="mainstreet-sun studio-float"></div><div class="mainstreet-lines"></div><div class="street-building building-one"><span>MAIN STREET</span><i></i><i></i><b></b></div><div class="street-building building-two"><span>midvora.</span><div class="shop-awning"></div><i></i><i></i><b></b></div><div class="street-building building-three"><i></i><i></i><i></i><i></i><b></b></div><span class="street-label">107 E MAIN / MARSHALL, MINNESOTA</span></div><div data-home-reveal><p class="home-eyebrow">From our main street to yours</p><h2>Small-town roots.<br /><em>Wide-open thinking.</em></h2><p>We work with businesses across Minnesota, South Dakota, and North Dakota. A phone call, a text, a little back-and-forth. Good things don’t have to be complicated.</p><p>A little farther away? You’re welcome here, too. We work remotely with businesses wherever they call home.</p><a class="home-text-link" href="/contact">Let’s get acquainted <span aria-hidden="true">↗︎</span></a><div class="neighborhood-signature"><span>With a little local pride,</span><strong>Midvora<span>.</span></strong></div></div></div></section>
  <StudioCTA eyebrow="Your business has a story worth telling" title="Let’s give it" accent="a little more light." />
</BaseLayout>
