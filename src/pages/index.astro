---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeTransformation from '../components/HomeTransformation.astro';
import HomeLightArt from '../components/HomeLightArt.astro';
import HomeOffer from '../components/HomeOffer.astro';
import HomeProcess from '../components/HomeProcess.astro';
import HomePricing from '../components/HomePricing.astro';

const projects = [
  { name: 'La Michoacana Elite', short: 'Michoacana', type: 'Ice cream. Full personality.', category: 'Food & drink', image: '/work/michoacana-1.webp', url: 'https://lamichoacanaelitemn.com/', domain: 'lamichoacanaelitemn.com', color: 'pink' },
  { name: 'La Tapatia Food Truck', short: 'La Tapatia', type: 'A local favorite, ready to roll.', category: 'Food & drink', image: '/work/tapatia-1.webp', url: 'https://latapatiafoodtruck.com/', domain: 'latapatiafoodtruck.com', color: 'peach' },
  { name: 'Animal Health Center', short: 'Animal Health', type: 'Big care. A welcoming new home.', category: 'Pet care & retail', image: '/work/animal.webp', url: 'https://marshallanimalhealth.com/', domain: 'marshallanimalhealth.com', color: 'sage' },
];
---
<BaseLayout home title="Midvora — Your Business, in a Whole New Light." description="Distinctive websites for local businesses. Built in Marshall, Minnesota. Get a free working homepage sample in 24 hours. Website packages from $525.">
  <section id="hero" class="home-hero">
    <div class="home-shell">
      <div class="home-hero-grid">
        <div class="home-hero-copy">
          <p class="home-eyebrow"><span class="home-status-dot"></span> Independent web studio · Marshall, MN</p>
          <h1>Your business.<br />In a whole<br /><em>new light.</em></h1>
          <p class="home-hero-description">Good businesses deserve to be seen.<br class="home-desktop-break" /> We make websites with the character, craft, and care to make that happen.</p>
          <div class="home-hero-actions">
            <a href="#sample-form" class="home-button home-button-blue">Bring my website to life <span aria-hidden="true">↗︎</span></a>
            <a href="#selected-work" class="home-text-link">Explore our work <span aria-hidden="true">↓</span></a>
          </div>
          <p class="home-hero-note"><span aria-hidden="true">✓</span> Your first look is on us. Free sample in 24 hours.</p>
        </div>
        <HomeLightArt />
      </div>
      <div class="home-hero-foot"><p><span class="home-name-part">Mid<span>west</span></span><span class="home-name-plus">+</span><span class="home-name-part">vora<span> / light</span></span><span class="home-name-meaning">Rooted here. Radiating outward.</span></p><a href="#selected-work">See what that looks like <span aria-hidden="true">↙</span></a></div>
    </div>
  </section>
  <HomeOffer />

  <section id="selected-work" class="home-work home-section">
    <div class="home-shell">
      <div class="home-section-heading"><div><p class="home-eyebrow">01 / A few local originals</p><h2>Different businesses.<br /><em>Distinctly their own.</em></h2></div><a href="/work" class="home-text-link">All our work <span aria-hidden="true">↗︎</span></a></div>
      <div class="home-work-grid">
        {projects.map((project, i) => <article class={`home-work-card ${project.color}`}>
          <a href={project.url} target="_blank" rel="noopener noreferrer" class="home-work-image">
            <div class="home-work-image-top"><span>0{i + 1} / {project.category}</span><span class="home-live"><i></i> Live site</span></div>
            <div class="home-work-window"><div class="home-work-chrome" aria-hidden="true"><i></i><i></i><i></i></div><img src={project.image} alt={`${project.name} homepage`} width="1200" height={i === 2 ? 684 : 575} loading="lazy" decoding="async" /></div>
            <span class="home-work-arrow" aria-hidden="true">↗︎</span>
            <span class="sr-only">Opens in a new tab</span>
          </a>
          <div class="home-work-caption"><div><h3><a href={project.url} target="_blank" rel="noopener noreferrer">{project.name}</a></h3><p>{project.type}</p></div><span>Marshall, MN</span></div>
        </article>)}
      </div>
    </div>
  </section>

  <HomeTransformation />

  <HomeProcess />
  <HomePricing />

  <section id="cta-banner" class="home-contact home-section">
    <div class="home-shell home-contact-grid">
      <div class="home-contact-copy"><p class="home-eyebrow">04 / Your next chapter starts here</p><h2>Let’s make<br />you <em>the one</em><br />they remember<span>.</span></h2><p>Get a free homepage sample made for your business. No payment details. No pressure. Just a good place to start.</p><a href="tel:+15075304837" class="home-contact-call">More of a phone person? <strong>(507) 530-4837 ↗︎</strong></a><div class="home-contact-spark" aria-hidden="true">✳</div></div>
      <form id="sample-form" class="home-form">
        <div class="home-form-heading"><h3>Meet your next website.</h3><span>FREE SAMPLE</span></div><p>A little about you. Then we get to work.</p>
        <label for="business-name">Business name<input id="business-name" name="businessName" autocomplete="organization" placeholder="The name above your door" required maxlength="160" /></label>
        <div class="home-form-row">
          <label for="business-type">What do you do?<select id="business-type" name="businessType" required><option value="" disabled selected>Select business type</option><option>Restaurant or café</option><option>Retail or boutique</option><option>Salon or wellness</option><option>Contractor or home services</option><option>Auto services</option><option>Pet care</option><option>Professional services</option><option>Something else</option></select></label>
          <label for="business-city">City & state<input id="business-city" name="city" autocomplete="address-level2" placeholder="Marshall, MN" required maxlength="160" /></label>
        </div>
        <label for="business-contact">Email or phone<input id="business-contact" name="contact" placeholder="Where should we send your sample?" required maxlength="200" /></label>
        <div class="home-honeypot" aria-hidden="true"><label>Leave this empty<input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label></div>
        <button type="submit" class="home-button home-button-blue"><span data-submit-label>Make my free sample</span><span aria-hidden="true">↗︎</span></button>
        <p class="home-form-fine">$0 until you approve. Your sample is yours to keep.</p><p id="form-status" class="home-form-status" role="status" aria-live="polite" hidden></p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#sample-form');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const submitLabel = form?.querySelector<HTMLElement>('[data-submit-label]');
  const status = document.querySelector<HTMLElement>('#form-status');
  if (form && submit && submitLabel && status) {
    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (submit.disabled) return;
      const data = new FormData(form);
      if (data.get('botcheck')) return;
      submit.disabled = true;
      submitLabel.textContent = 'Sending your request…';
      status.hidden = true;
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 15000);
      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, signal: controller.signal,
          body: JSON.stringify({ access_key: 'e7f6edce-9410-45b7-a058-a03f661f953b', subject: 'New Free Sample Request — Midvora (Homepage)', from_name: data.get('businessName'), businessName: data.get('businessName'), businessType: data.get('businessType'), city: data.get('city'), contact: data.get('contact') }),
        });
        const result = await response.json();
        if (!response.ok || !result.success) throw new Error('Submission failed');
        status.textContent = 'You’re on the list! We’ll reach out about your free sample within 24 hours.';
        status.dataset.state = 'success';
        form.reset();
      } catch {
        status.textContent = 'Your request didn’t go through. Please try again, or call (507) 530-4837.';
        status.dataset.state = 'error';
      } finally {
        window.clearTimeout(timeout);
        status.hidden = false;
        submit.disabled = false;
        submitLabel.textContent = 'Make my free sample';
      }
    });
  }
  const scrollTarget = new URLSearchParams(window.location.search).get('scrollTo');
  if (scrollTarget) {
    const target = document.getElementById(scrollTarget);
    if (target) requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
  }
</script>
