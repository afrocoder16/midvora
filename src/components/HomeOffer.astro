---
const offerRibbon = ['24-hour free sample', '$0 until you approve', 'Websites from $525', 'Made in the Midwest'];
const craftRibbon = ['Custom design', 'Mobile first', 'Hosting included', 'Security included', 'Weekly maintenance'];
const stats = [
  { number: '70%+', target: 70, prefix: '', suffix: '%+', name: 'Less than a $2,500 build', copy: 'Our $525 starting price leaves more of your budget for the business itself.', color: 'blue' },
  { number: '24h', target: 24, prefix: '', suffix: 'h', name: 'Your sample, in your hands', copy: 'A real working homepage, designed around your business. Free to explore.', color: 'orange' },
  { number: '$0', target: 0, prefix: '$', suffix: '', name: 'Before you say yes', copy: 'See the direction. Try the sample. Decide when it feels right.', color: 'green' },
  { number: '5–7', target: undefined, prefix: '', suffix: '', name: 'Days from approval to live', copy: 'For Starter websites, with your content ready. We handle the details.', color: 'violet' },
];
---
<div class="home-ribbons" data-motion-zone>
  <p class="sr-only">Free 24-hour sample, websites from $525. Custom design, hosting, security, and weekly maintenance included.</p>
  <div class="home-ribbon home-ribbon-offer" aria-hidden="true"><div class="home-ribbon-track">{[0, 1].map(() => <div class="home-ribbon-segment">{offerRibbon.map(item => <><span>{item}</span><i>✳</i></>)}</div>)}</div></div>
  <div class="home-ribbon home-ribbon-craft" aria-hidden="true"><div class="home-ribbon-track">{[0, 1].map(() => <div class="home-ribbon-segment">{craftRibbon.map(item => <><span>{item}</span><i>✳</i></>)}</div>)}</div></div>
</div>
<section id="stats-section" class="home-offer home-section" data-motion-zone>
  <div class="home-shell">
    <div class="home-offer-heading" data-home-reveal><p class="home-eyebrow">The instant proof</p><h2>Numbers that make<br /><em>the offer real.</em></h2><p>Big attention to detail.{' '}<br />A surprisingly small place to start.</p></div>
    <div class="home-offer-grid">
      {stats.map((stat, i) => <article class={`home-offer-stat stat-${stat.color}`} data-home-reveal style={`--reveal-order:${i}`}>
        <p class="home-offer-number"><span class="sr-only">{stat.number}{i === 3 ? ' days' : ''}</span><span aria-hidden="true" data-counter={stat.target} data-counter-prefix={stat.prefix} data-counter-suffix={stat.suffix}>{stat.number}</span>{i === 3 && <small aria-hidden="true">days</small>}</p>
        <div class="home-offer-rule" aria-hidden="true"></div><h3>{stat.name}</h3><p class="home-offer-copy">{stat.copy}</p>
      </article>)}
    </div>
    <div class="home-offer-foot"><span>Good work. Clear numbers. A little less guesswork.</span><a href="#pricing">See what $525 includes <span aria-hidden="true">↗︎</span></a></div>
  </div>
</section>
